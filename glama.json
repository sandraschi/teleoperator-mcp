{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "name": "teleoperator-mcp",
  "display_name": "Teleoperator MCP",
  "description": "WebXR teleoperation MCP gateway: VR pose from Pico/Meta Quest to fleet robots, ProducerCommand adapter layer, dual-mode telesupervision target.",
  "type": "mcp_server",
  "status": "alpha",
  "framework": "FastMCP 3.4+",
  "version": "0.1.0",
  "icon": "gamepad",
  "homeUrl": "https://github.com/sandraschi/teleoperator-mcp",
  "homepage": "http://localhost:10900",
  "entrypoint": "uv run python -m teleoperator_mcp.server --mode dual --port 10901",
  "transport": {
    "type": "http",
    "url": "http://localhost:10901/mcp",
    "sse_url": "http://localhost:10901/sse"
  },
  "runtime": {
    "python": ">=3.12",
    "fastmcp": "3.4.4",
    "web_port": 10900,
    "backend_port": 10901
  },
  "keywords": ["webxr", "teleoperation", "pico", "robotics", "livekit", "boomy", "mcp"],
  "capabilities": {
    "tools": 12,
    "prompts": false,
    "resources": false,
    "sampling": false,
    "skills": false,
    "webxr": true
  }
}
