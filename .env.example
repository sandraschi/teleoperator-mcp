# Copy to .env and adjust for your tailnet hostname (from: tailscale serve status)
TELEOP_YAHBOOM_API_URL=http://127.0.0.1:10892
TELEOP_CORS_ORIGINS=https://goliath.tailfab45.ts.net,http://localhost:10900,http://127.0.0.1:10900
TELEOP_WATCHDOG_MS=300
# AUTO safety (nav stub)
TELEOP_AUTO_MAX_DURATION_S=10
TELEOP_AUTO_REQUIRE_WEBXR=1
TELEOP_NAV_STUB_LINEAR=0.06
# Spoken warnings (speech-mcp on 10909)
TELEOP_SPEECH_ENABLED=1
TELEOP_SPEECH_MCP_URL=http://127.0.0.1:10909
TELEOP_SPEECH_PROVIDER=windows
